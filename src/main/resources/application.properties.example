# Application
spring.application.name=satya-social

# Database
spring.datasource.url=jdbc:mysql://localhost:3306/satya_social
spring.datasource.username=root
spring.datasource.password=YOUR_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# Setu PAN API
setu.pan.base-url=https://dg-sandbox.setu.co
setu.pan.client-id=YOUR_CLIENT_ID
setu.pan.client-secret=YOUR_CLIENT_SECRET
setu.pan.product-instance-id=YOUR_PRODUCT_INSTANCE_ID

# JWT
jwt.secret=YOUR_JWT_SECRET_MIN_32_CHARS
jwt.expiry=86400000

# Server
server.port=8080